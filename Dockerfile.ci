# Dockerfile para ejecutar pruebas E2E con Playwright + Cucumber BDD
# Modo headless con Chromium en Alpine Linux

FROM node:20-alpine

# Instalar dependencias del sistema para Chromium headless
RUN apk add --no-cache \
    chromium \
    nss \
    freetype \
    harfbuzz \
    ca-certificates \
    ttf-freefont \
    font-noto \
    udev \
    xvfb

# Variables de entorno para Playwright + Chromium
ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
ENV PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=/usr/bin/chromium-browser
ENV CI=true

WORKDIR /app

# Instalar dependencias primero (cache layer)
COPY package*.json ./
RUN npm ci

# Copiar todo el proyecto (incluye e2e/, playwright.config.ts, etc.)
COPY . .

# Verificar que Chromium está disponible
RUN chromium-browser --version || echo "Chromium installed"

# Generar los tests BDD y ejecutar Playwright en modo headless
CMD ["sh", "-c", "npx bddgen && npx playwright test --reporter=html,json --workers=1"]
